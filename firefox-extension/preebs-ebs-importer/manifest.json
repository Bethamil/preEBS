{
  "manifest_version": 3,
  "name": "PreEBS -> EBS Importer",
  "description": "Paste PreEBS export JSON and fill the Oracle EBS timecard grid.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "preebs-ebs-importer@preebs.local",
      "strict_min_version": "101.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PreEBS Importer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
